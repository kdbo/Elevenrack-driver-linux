+/* Exact rate/quantum overrides; missing profiles retain the base model. */
+static int eleven_profile_index(uint32_t value, bool rate)
+{
+	static const uint32_t rates[] = { 44100, 48000, 88200, 96000 };
+	static const uint32_t quanta[] = { 64, 128, 256, 512, 1024, 2048 };
+	const uint32_t *values = rate ? rates : quanta;
+	unsigned int count = rate ? SPA_N_ELEMENTS(rates) : SPA_N_ELEMENTS(quanta);
+	for (unsigned int i = 0; i < count; i++)
+		if (values[i] == value)
+			return i;
+	return -1;
+}
