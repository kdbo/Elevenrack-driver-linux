+/* Publish on the main loop through an owned event source. Removing the source
+ * during clear cancels pending updates before the node memory is released. */
+static void phase_publish_latency(struct spa_source *source)
+{
+	struct state *state = source->data;
+	uint64_t events, update;
+	if (read(source->fd, &events, sizeof(events)) != sizeof(events)) return;
+	update = atomic_load_explicit(&state->phase_pending, memory_order_acquire);
+	int32_t frames = (uint32_t)update;
+	uint32_t quantum = (update >> 32) & 0x3fff;
+	uint32_t rate = update >> 46;
+	if (!state->started || !eleven_latency_rate(state->rate) || (uint32_t)state->rate != rate || state->threshold != quantum) return;
+	if ((int64_t)state->latency[state->port_direction].min_rate == (int64_t)frames) return;
+	state->latency[state->port_direction].min_rate = frames;
+	state->latency[state->port_direction].max_rate = frames;
+	state->port_info.change_mask |= SPA_PORT_CHANGE_MASK_PARAMS;
+	state->port_params[PORT_Latency].user++;
+	spa_alsa_emit_port_info(state, false);
+}
