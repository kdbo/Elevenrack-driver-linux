[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = eleven-rack-driver

[Action]
Description = Refreshing initramfs after Eleven Rack driver changes...
When = PostTransaction
Exec = /bin/sh -c "if command -v mkinitcpio >/dev/null 2>&1; then mkinitcpio -P; elif command -v dracut >/dev/null 2>&1; then dracut --regenerate-all --force; fi"
