{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eleven Rack Editor",
  "version": "0.1.2-beta16",
  "identifier": "io.github.kdbo.elevenrack.editor.tauri-preview",
  "build": {
    "frontendDist": "../.generated",
    "beforeDevCommand": "npm run frontend-dir",
    "beforeBuildCommand": "npm run frontend-dir"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eleven Rack Editor",
        "width": 1500,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0e0e0e",
        "decorations": true,
        "resizable": true,
        "center": true,
        "create": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Eleven Rack Editor",
        "url": "splash.html",
        "width": 520,
        "height": 380,
        "decorations": false,
        "resizable": false,
        "center": true,
        "backgroundColor": "#0e0e0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main",
            "splash"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Music",
    "shortDescription": "Eleven Rack Editor",
    "resources": {
      "../UserManual.txt": "UserManual.txt",
      "../../editor/LICENSE": "LICENSE",
      "../../editor/NOTICE": "NOTICE"
    },
    "icon": [
      "../../editor/assets/eleven-rack-editor-logo.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ]
      }
    }
  }
}
